local function GetPlayerRole()
    local Dados = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not Dados then return nil end
    local ok, Res = pcall(function() return Dados:InvokeServer() end)
    if not ok or not Res then return nil end
