-- 🔫 PEGAR ARMA AUTOMÁTICO
local function GetPlayerRole()
    local DataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not DataRemote then return nil end
    local ok, Data = pcall(function() return DataRemote:InvokeServer() end)
    if not ok or not Data then return nil end
    local PlayerData = Data[player.Name]
    return PlayerData and PlayerData.Role or nil
end

local function FindMap()
    for _, child in ipairs(workspace:GetChildren()) do
        if child:GetAttribute("MapID") then return child end
    end
    return nil
end

local function GetGun()
    pcall(function()
        if not AutoGrabGun then return end
        if not player:GetAttribute("Alive") then return end
        if GetPlayerRole() == "Murderer" then return end
        local map = FindMap()
        if not map then return end
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local gunDrop = map:FindFirstChild("GunDrop")
        if gunDrop then
            gunDrop.CFrame = character.HumanoidRootPart.CFrame
        end
    end)
end

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        GetGun()
    end
end)

