local AutoShoot = false
local ShowShootButton = false
local AutoGrabGun = false
local ShootPredictMultiplier = 1.25
local ShootButtonGui = nil
local isDragging = false
local dragStartPos = nil
local buttonStartPos = nil

-- =============================================
-- SISTEMA DA ABA XERIFE 
-- =============================================

local function GetMurderer()
    local DataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not DataRemote then return nil end
    local ok, Data = pcall(function() return DataRemote:InvokeServer() end)
    if not ok or not Data then return nil end
    for _, Player in next, Players:GetPlayers() do
        if Player ~= player and Player:GetAttribute("Alive") then
            local Info = Data[Player.Name]
            if Info and Info.Role == "Murderer" then
                return Player
            end
        end
    end
    return nil
end

-- PEGAR PING
local function GetPing()
    local Stats = game:GetService("Stats")
    local ok, value = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and value or 100
end

-- ATIRAR COM PREDIÇÃO
local function ShootMurderer()
    local Char = player.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end

    local Gun = Char:FindFirstChild("Gun") or (player.Backpack and player.Backpack:FindFirstChild("Gun"))
    if not Gun then return end
    if Gun.Parent ~= Char then
        Gun.Parent = Char
        task.wait(0.05)
    end

    local Murderer = GetMurderer()
    if not Murderer or not Murderer.Character then return end

    local TargetHRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
    local TargetTorso = Murderer.Character:FindFirstChild("Torso") or Murderer.Character:FindFirstChild("UpperTorso")
    if not TargetHRP or not TargetTorso then return end

    local Ping = GetPing()
    local PredictionTime = (Ping / 1000) * ShootPredictMultiplier
    local Velocity = TargetHRP.Velocity
    local PredictedPos

    if Velocity.Magnitude < 1 then
        PredictedPos = TargetTorso.Position
    else
        PredictedPos = TargetTorso.Position + (Velocity * PredictionTime)
    end

    local TargetCFrame = CFrame.new(PredictedPos)
    local ShootEvent = Gun:FindFirstChild("ShootEvent", true) or Gun:FindFirstChild("Shoot", true)
    if ShootEvent then
        ShootEvent:FireServer(TargetCFrame)
    end
end

-- 🖱️ BOTÃO FLUTUANTE
local function CreateShootButton()
    if ShootButtonGui then return end
    local Gui = Instance.new("ScreenGui")
    Gui.Name = "XerifeTiro"
    Gui.ResetOnSpawn = false
    Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    Gui.Parent = CoreGui

    local Btn = Instance.new("ImageButton")
    Btn.Size = UDim2.new(0,80,0,80)
    Btn.Position = UDim2.new(0.5,-40,0.5,-40)
    Btn.BackgroundColor3 = Color3.fromRGB(255,40,40)
    Btn.BackgroundTransparency = 0.3
    Btn.BorderSizePixel = 0
    Btn.Parent = Gui
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(1,0)

    local Icone = Instance.new("TextLabel")
    Icone.Size = UDim2.new(1,0,1,0)
    Icone.BackgroundTransparency = 1
    Icone.Text = "\u{1f52b}"
    Icone.TextSize = 32
    Icone.TextColor3 = Color3.new(1,1,1)
    Icone.Font = Enum.Font.GothamBold
    Icone.Parent = Btn

    Btn.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            buttonStartPos = Btn.Position
            dragStartPos = Input.Position
            Input.Changed:Connect(function()
                if Input.UserInputState == Enum.UserInputState.End then
                    isDragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if isDragging and (Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseMovement) then
            Btn.Position = buttonStartPos + UDim2.fromOffset(Input.Position.X - dragStartPos.X, Input.Position.Y - dragStartPos.Y)
        end
    end)

    Btn.MouseButton1Click:Connect(function()
        if not isDragging then ShootMurderer() end
    end)

    ShootButtonGui = Gui
end

local function RemoveShootButton()
    if ShootButtonGui then
        ShootButtonGui:Destroy()
        ShootButtonGui = nil
    end
end

