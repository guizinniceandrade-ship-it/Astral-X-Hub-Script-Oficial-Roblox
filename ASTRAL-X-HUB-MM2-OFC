local function ShootMurderer()
    local Char = player.Character
    if not Char or not Char:FindFirstChild("HumanoidRootPart") then return end

    local Gun = Char:FindFirstChild("Gun") or (player.Backpack and player.Backpack:FindFirstChild("Gun"))
    if not Gun then return end
    
    if Gun.Parent ~= Char then
        Gun.Parent = Char
        task.wait(0.05)
    end

    local Murderer = GetMurderer()
    if not Murderer or not Murderer.Character then return end

    local TargetHRP = Murderer.Character:FindFirstChild("HumanoidRootPart")
    local TargetTorso = Murderer.Character:FindFirstChild("Torso") or Murderer.Character:FindFirstChild("UpperTorso")
    if not TargetHRP or not TargetTorso then return end

    -- Cálculo de Predição por Ping
    local Ping = GetPing()
    local PredictionTime = (Ping / 1000) * ShootPredictMultiplier
    local Velocity = TargetHRP.Velocity
    local PredictedPos

    if Velocity.Magnitude < 1 then
        PredictedPos = TargetTorso.Position
    else
        PredictedPos = TargetTorso.Position + (Velocity * PredictionTime)
    end

    -- Cálculo de Origem e Alvo
    local OriginCFrame
    if MagicBullet then
        OriginCFrame = CFrame.new(TargetTorso.Position, PredictedPos)
    else
        OriginCFrame = CFrame.new(Char.HumanoidRootPart.Position, PredictedPos)
    end

    local TargetCFrame = CFrame.new(PredictedPos)
    local ShootEvent = Gun:FindFirstChild("ShootEvent", true) or Gun:FindFirstChild("Shoot", true)

    if ShootEvent then
        ShootEvent:FireServer(OriginCFrame, TargetCFrame)
    end
end

